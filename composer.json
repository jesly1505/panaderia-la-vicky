{
    "name": "lavicky/erp",
    "description": "ERP Panadería La Vicky - Sistema de gestión integral (inventarios, recetas, producción y ventas)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/"
        },
        "files": [
            "config/env.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "php tools/lint.php",
        "test": "php tests/run.php",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
