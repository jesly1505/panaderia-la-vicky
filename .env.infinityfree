# =========================================================================
# CONFIGURACIÓN DE ENTORNOS PARA INFINITYFREE
# =========================================================================
# Este archivo contiene la configuración exacta requerida para InfinityFree.
# Cámbiale el nombre a ".env" una vez subido a la carpeta "htdocs/" en tu servidor.

# 1. Host de la base de datos (NO USAR localhost en InfinityFree)
DB_HOST=sql212.infinityfree.com

# 2. Nombre de la Base de Datos
DB_NAME=if0_42542716_panaderia

# 3. Usuario de la Base de Datos
DB_USER=if0_42542716

# 4. Contraseña de la Base de Datos
DB_PASS=if0_42542716

# 5. Entorno de la aplicación
APP_ENV=production

# 6. Ruta de mysqldump
MYSQLDUMP_PATH=
