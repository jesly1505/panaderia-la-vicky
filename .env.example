# Configuración de Base de Datos
DB_HOST=localhost
DB_NAME=la_vicky_db
DB_USER=root
DB_PASS=

# Configuración del Entorno (local / production)
# En producción, pon APP_ENV=production para ocultar los errores al usuario.
APP_ENV=local

# Ruta opcional de mysqldump (solo si es diferente a la ruta estándar)
# En Windows (XAMPP): c:\xampp\mysql\bin\mysqldump.exe
# En Hosting Linux: suele ser /usr/bin/mysqldump o simplemente mysqldump (dejar vacío para usar del PATH)
MYSQLDUMP_PATH=
